# Managed by DragonTools
[Unit]
Description=DragonTools host maintenance events
After=systemd-journald.service

[Service]
Type=oneshot
User=dt-host-events
Group=dt-host-events
ExecStart=/opt/dragontools/agent/current/dragontool-agent maintenance events
TimeoutStartSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/dragontools/host-events
UMask=0077
LimitCORE=0
StandardOutput=journal
StandardError=null
